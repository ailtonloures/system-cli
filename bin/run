#!/usr/bin/env bash
set -euo pipefail

_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
readonly SCRIPT_DIR

# shellcheck source=../lib/ui.sh
source "${SCRIPT_DIR}/../lib/ui.sh"

readonly SCRIPTS_DIR="${SCRIPTS_DIR:-$HOME/Scripts}"

show_help() {
  cat <<EOF
Usage: run [script-name]

Run scripts from $SCRIPTS_DIR.

  run              Pick a script interactively
  run <name>       Run a script by name (.sh extension optional)
  run help         Show this help

Examples:
  run backup
  run backup.sh
  run
EOF
}

# Prints "<uid> <octal-mode>" for a path (GNU stat first, BSD/macOS fallback)
_stat_owner_mode() {
  stat -c '%u %a' "$1" 2>/dev/null || stat -f '%u %Lp' "$1"
}

# Succeeds only if the path is owned by the current user and is not
# writable by group/others
check_safe() {
  local path="$1" kind="$2" owner mode
  read -r owner mode < <(_stat_owner_mode "$path") || {
    error "Cannot stat $kind: $path"
    return 1
  }
  if [[ "$owner" != "$(id -u)" ]]; then
    error "Refusing to use $kind not owned by you: $path"
    return 1
  fi
  if (( (8#$mode & 8#022) != 0 )); then
    error "Refusing to use $kind writable by group/others: $path"
    echo "Fix with: chmod go-w $path" >&2
    return 1
  fi
}

check_scripts_dir() {
  if [[ ! -d "$SCRIPTS_DIR" ]]; then
    error "Directory not found: $SCRIPTS_DIR"
    exit 1
  fi
  check_safe "$SCRIPTS_DIR" "scripts directory" || exit 1
}

run_script() {
  local name="$1"

  if [[ "$name" == */* || "$name" == *..* || "$name" == -* ]]; then
    error "Invalid script name: $name"
    exit 1
  fi

  local script="$SCRIPTS_DIR/$name"
  [[ "$script" != *.sh ]] && script="${script}.sh"

  if [[ ! -f "$script" ]]; then
    error "Script not found: $script"
    exit 1
  fi

  check_scripts_dir
  check_safe "$script" "script" || exit 1

  bash "$script"
}

run_picker() {
  check_scripts_dir

  shopt -s nullglob
  local scripts=("$SCRIPTS_DIR"/*.sh)
  shopt -u nullglob

  if [[ ${#scripts[@]} -eq 0 ]]; then
    error "No .sh scripts found in $SCRIPTS_DIR"
    exit 1
  fi

  header "Available scripts:"
  for i in "${!scripts[@]}"; do
    echo "  $((i + 1))) $(basename "${scripts[$i]}")"
  done

  echo ""
  read -rp "Pick a script [1-${#scripts[@]}]: " choice

  if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#scripts[@]} )); then
    local selected="${scripts[$((choice - 1))]}"
    check_safe "$selected" "script" || exit 1
    bash "$selected"
  else
    error "Invalid option."
    exit 1
  fi
}

main() {
  local cmd="${1:-}"

  case "$cmd" in
    --version|-V)   show_version ;;
    help|--help|-h) show_help ;;
    "")             run_picker ;;
    *)              run_script "$cmd" ;;
  esac
}

main "$@"
