#!/usr/bin/env bash
set -euo pipefail

_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
readonly SCRIPT_DIR="$(cd -P "$(dirname "$_src")" && pwd)"

# shellcheck source=../lib/ui.sh
source "${SCRIPT_DIR}/../lib/ui.sh"

readonly SSH_CONFIG="${HOME}/.ssh/config"

show_help() {
  cat <<EOF
Usage: conn <command> [args]

Commands:
  <alias>            Connect to a saved SSH host
  add <alias>        Add a new SSH connection (interactive)
  edit <alias>       Edit an existing connection
  remove <alias>     Remove a saved connection
  list               List all configured connections
  keygen [name]      Generate an SSH key pair (ed25519, rsa, ecdsa)
  help               Show this help

Examples:
  conn hermes
  conn add hermes
  conn edit hermes
  conn remove hermes
  conn list
  conn keygen deploy
EOF
}

conn_ensure_config() {
  mkdir -p "${HOME}/.ssh"
  chmod 700 "${HOME}/.ssh"
  if [[ ! -f "$SSH_CONFIG" ]]; then
    touch "$SSH_CONFIG"
    chmod 600 "$SSH_CONFIG"
  fi
}

conn_host_exists() {
  local alias="$1"
  grep -qiE "^Host[[:space:]]+${alias}$" "$SSH_CONFIG" 2>/dev/null
}

conn_connect() {
  local alias="$1"
  conn_ensure_config

  if ! conn_host_exists "$alias"; then
    error "Host '$alias' not found in ${SSH_CONFIG}"
    echo "  Run: conn add $alias"
    exit 1
  fi

  ssh "$alias"
}

conn_add() {
  local alias="${1:-}"
  if [[ -z "$alias" ]]; then
    error "Missing alias. Usage: conn add <alias>"
    exit 1
  fi

  if [[ ! "$alias" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    error "Invalid alias '$alias'. Use only letters, digits, dots, hyphens, and underscores."
    exit 1
  fi

  conn_ensure_config

  if conn_host_exists "$alias"; then
    error "Host '$alias' already exists in ${SSH_CONFIG}"
    exit 1
  fi

  header "Adding SSH connection: $alias"

  local hostname user port identity_file

  read -rp "  Hostname/IP: " hostname
  if [[ -z "$hostname" ]]; then
    error "Hostname cannot be empty."
    exit 1
  fi

  read -rp "  User: " user
  if [[ -z "$user" ]]; then
    error "User cannot be empty."
    exit 1
  fi

  read -rp "  Port [22]: " port
  port="${port:-22}"

  if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
    error "Invalid port '$port'. Must be a number between 1 and 65535."
    exit 1
  fi

  read -rp "  IdentityFile (leave empty to skip): " identity_file
  read -rp "  ProxyJump (leave empty to skip): " proxy_jump

  {
    echo ""
    echo "Host $alias"
    echo "  HostName $hostname"
    echo "  User $user"
    echo "  Port $port"
    if [[ -n "$identity_file" ]]; then
      echo "  IdentityFile $identity_file"
    fi
    if [[ -n "$proxy_jump" ]]; then
      echo "  ProxyJump $proxy_jump"
    fi
  } >> "$SSH_CONFIG"

  info "Connection '$alias' added."
}

conn_edit() {
  local alias="${1:-}"
  if [[ -z "$alias" ]]; then
    error "Missing alias. Usage: conn edit <alias>"
    exit 1
  fi

  conn_ensure_config

  if ! conn_host_exists "$alias"; then
    error "Host '$alias' not found in ${SSH_CONFIG}"
    exit 1
  fi

  local cur_hostname cur_user cur_port cur_identity cur_proxy
  cur_hostname=$(ssh -G "$alias" 2>/dev/null | awk '/^hostname / {print $2}')
  cur_user=$(ssh -G "$alias" 2>/dev/null | awk '/^user / {print $2}')
  cur_port=$(ssh -G "$alias" 2>/dev/null | awk '/^port / {print $2}')
  cur_identity=$(ssh -G "$alias" 2>/dev/null | awk '/^identityfile / {print $2; exit}')
  cur_proxy=$(ssh -G "$alias" 2>/dev/null | awk '/^proxyjump / {print $2}')

  header "Editing connection: $alias"
  echo ""

  local hostname user port identity_file proxy_jump
  read -rp "  Hostname/IP [${cur_hostname}]: " hostname
  hostname="${hostname:-$cur_hostname}"

  read -rp "  User [${cur_user}]: " user
  user="${user:-$cur_user}"

  read -rp "  Port [${cur_port}]: " port
  port="${port:-$cur_port}"

  if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
    error "Invalid port '$port'. Must be a number between 1 and 65535."
    exit 1
  fi

  read -rp "  IdentityFile [${cur_identity:-(none)}]: " identity_file
  identity_file="${identity_file:-$cur_identity}"

  read -rp "  ProxyJump [${cur_proxy:-(none)}]: " proxy_jump
  proxy_jump="${proxy_jump:-$cur_proxy}"

  local tmp
  tmp=$(mktemp)

  awk -v host="$alias" '
    BEGIN { skip=0 }
    /^Host[[:space:]]/ {
      if ($2 == host) { skip=1; next }
      else { skip=0 }
    }
    skip && /^[[:space:]]/ { next }
    skip && /^$/ { skip=0; next }
    !skip { print }
  ' "$SSH_CONFIG" > "$tmp"

  {
    echo ""
    echo "Host $alias"
    echo "  HostName $hostname"
    echo "  User $user"
    echo "  Port $port"
    if [[ -n "$identity_file" ]]; then
      echo "  IdentityFile $identity_file"
    fi
    if [[ -n "$proxy_jump" ]]; then
      echo "  ProxyJump $proxy_jump"
    fi
  } >> "$tmp"

  mv "$tmp" "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"

  info "Connection '$alias' updated."
}

conn_remove() {
  local alias="${1:-}"
  if [[ -z "$alias" ]]; then
    error "Missing alias. Usage: conn remove <alias>"
    exit 1
  fi

  conn_ensure_config

  if ! conn_host_exists "$alias"; then
    error "Host '$alias' not found in ${SSH_CONFIG}"
    exit 1
  fi

  read -rp "Remove '$alias' from SSH config? [y/N] " confirm
  if [[ "$confirm" != [yY] ]]; then
    echo "Cancelled."
    return
  fi

  local tmp
  tmp=$(mktemp)

  awk -v host="$alias" '
    BEGIN { skip=0 }
    /^Host[[:space:]]/ {
      if ($2 == host) { skip=1; next }
      else { skip=0 }
    }
    skip && /^[[:space:]]/ { next }
    skip && /^$/ { skip=0; next }
    !skip { print }
  ' "$SSH_CONFIG" > "$tmp"

  mv "$tmp" "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"

  info "Connection '$alias' removed."
}

conn_list() {
  conn_ensure_config

  if [[ ! -s "$SSH_CONFIG" ]]; then
    echo "No connections configured."
    return
  fi

  local found=0

  while IFS= read -r line; do
    if [[ "$line" =~ ^Host[[:space:]]+(.+)$ ]]; then
      local alias="${BASH_REMATCH[1]}"
      [[ "$alias" == "*" ]] && continue
      local hostname user
      hostname=$(ssh -G "$alias" 2>/dev/null | awk '/^hostname / {print $2}')
      user=$(ssh -G "$alias" 2>/dev/null | awk '/^user / {print $2}')
      echo -e "  ${GREEN}${alias}${RESET} → ${user}@${hostname}"
      found=1
    fi
  done < "$SSH_CONFIG"

  if [[ "$found" -eq 0 ]]; then
    echo "No connections configured."
  fi
}

conn_keygen() {
  local name="${1:-}"
  local key_type key_flags default_name

  echo ""
  header "Select key type:"
  echo "  1) ed25519 (recommended)"
  echo "  2) rsa"
  echo "  3) ecdsa"
  read -rp "  Choice [1]: " choice
  choice="${choice:-1}"

  case "$choice" in
    1) key_type="ed25519"; key_flags="-t ed25519";       default_name="id_ed25519" ;;
    2) key_type="rsa";     key_flags="-t rsa -b 4096";   default_name="id_rsa" ;;
    3) key_type="ecdsa";   key_flags="-t ecdsa -b 521";  default_name="id_ecdsa" ;;
    *)
      error "Invalid choice: ${choice}"
      exit 1
      ;;
  esac

  name="${name:-$default_name}"
  local key_path="${HOME}/.ssh/${name}"

  if [[ -f "$key_path" ]]; then
    error "Key already exists: ${key_path}"
    exit 1
  fi

  mkdir -p "${HOME}/.ssh"

  header "Generating ${key_type} key: ${key_path}"
  # shellcheck disable=SC2086
  ssh-keygen ${key_flags} -f "$key_path"

  echo ""
  header "Public key:"
  cat "${key_path}.pub"
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    add)            conn_add "$@" ;;
    edit)           conn_edit "$@" ;;
    remove)         conn_remove "$@" ;;
    list|ls)        conn_list ;;
    keygen)         conn_keygen "$@" ;;
    --version|-V)   show_version ;;
    help|--help|-h) show_help ;;
    *)              conn_connect "$cmd" ;;
  esac
}

main "$@"
